{
  "name": "@moritzbrantner/r3f-vector-effects",
  "version": "0.2.0",
  "description": "React Three Fiber components for vector-like 3D paths, ribbons, trails, glows, dashes, and feathered panels.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/r3f-vector-effects.git"
  },
  "bugs": {
    "url": "https://github.com/moritzbrantner/r3f-vector-effects/issues"
  },
  "homepage": "https://github.com/moritzbrantner/r3f-vector-effects#readme",
  "keywords": [
    "react-three-fiber",
    "three",
    "webgl",
    "vector",
    "shader",
    "ribbon",
    "trail",
    "glow"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js",
      "require": "./dist/geometry.cjs"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js",
      "require": "./dist/materials.cjs"
    },
    "./experimental/tsl": {
      "types": "./dist/experimental/tsl.d.ts",
      "import": "./dist/experimental/tsl.js",
      "require": "./dist/experimental/tsl.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsup",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "example:dev": "bun --cwd examples/vite-r3f-demo dev",
    "example:build": "bun --cwd examples/vite-r3f-demo build",
    "demo": "bun run example:dev",
    "benchmark": "bun --cwd examples/benchmark dev",
    "benchmark:build": "bun --cwd examples/benchmark build",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "pack:check": "bun run check && bun run example:build && bun run benchmark:build && bun run pack:smoke && npm pack --dry-run"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^8.17.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.172.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vitest": "^2.1.8"
  }
}
